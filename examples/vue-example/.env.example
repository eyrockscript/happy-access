# Happy Access - Variables de Ambiente
# Copia este archivo a .env y configura los valores según tu entorno

# URL del API backend (default: http://localhost:3000/api)
VITE_API_ENDPOINT=http://localhost:3000/api

# Umbral de sonrisa requerida (0-1, default: 0.7)
# Valores más altos requieren una sonrisa más amplia
VITE_SMILE_THRESHOLD=0.7

# Umbral de coincidencia facial (0-1, default: 0.6)
# Valores más bajos son más estrictos en el reconocimiento
VITE_MATCH_THRESHOLD=0.6

# Ruta de los modelos de face-api.js
# Puedes usar CDN o una ruta local
VITE_MODELS_PATH=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.12/model
